{
  "name": "lina",
  "version": "0.1.4",
  "description": "LINA \u2014 a multi-agent AI development environment (Codex + Claude Code)",
  "private": true,
  "type": "module",
  "bin": {
    "lina": "bin/lina"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "node scripts/build.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "build:android": "bash scripts/build-android.sh",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:cli": "python3 scripts/verify-cli-pty.py",
    "verify:android": "python3 scripts/verify-android.py",
    "verify:ui": "TSX_TSCONFIG_PATH=web/tsconfig.json node --import tsx scripts/verify-ui.mjs && TSX_TSCONFIG_PATH=web/tsconfig.json node --import tsx scripts/verify-web.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "ink": "^8.0.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
